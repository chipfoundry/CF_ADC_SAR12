type ( BUS12_type0 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 12 ;
	bit_from : 11 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */
type ( BUS3_type1 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 3 ;
	bit_from : 2 ;
	bit_to : 0 ;
