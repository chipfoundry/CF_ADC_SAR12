type ( BUS12_type0 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 12 ;
	bit_from : 11 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */
type ( BUS3_type1 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 3 ;
	bit_from : 2 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */
type ( BUS4_type2 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 4 ;
	bit_from : 3 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */
type ( BUS2_type3 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 2 ;
	bit_from : 1 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */
type ( BUS10_type4 ) {
	base_type : array ;
	data_type : bit ;
	bit_width : 10 ;
	bit_from : 9 ;
	bit_to : 0 ;
        downto : true;
} /* end of type */

  lu_table_template(ccsn_dc) {
    variable_1 : input_voltage;
    variable_2 : output_voltage;
  }
  lu_table_template(ccsn_pnlh) {
    variable_1 : input_noise_height;
    variable_2 : input_noise_width;
    variable_3 : total_output_net_capacitance;
    variable_4 : time;
  }
  lu_table_template(ccsn_ovrf) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    variable_3 : time;
  }
cell( CF_ADC_SAR12 ) {
switch_cell_type : fine_grain;
is_macro_cell : true ;
  pg_pin (vboost) {
    pg_type : internal_power;
    voltage_name : vboost;
    direction : output;
  }
  pg_pin (VPUMP) {
    pg_type : primary_power;
    voltage_name : VPUMP;
    direction : input;
  } 
  pg_pin (vccd) {
    pg_type : primary_power;
    voltage_name : vccd;
    direction : input;
  }
  pg_pin (vccd_q) {
    pg_type : primary_power;
    voltage_name : vccd_q;
    direction : input;
  }
  pg_pin (vdda) {
    pg_type : primary_power;
    voltage_name : vdda;
    direction : input;
  }
  pg_pin (vdda_q) {
    pg_type : primary_power;
    voltage_name : vdda_q;
    direction : input;
  }
  pg_pin (vreflo) {
    pg_type : primary_ground;
    voltage_name : vreflo;
    direction : input;
  } 
  pg_pin (vpwr_int) {
    pg_type : internal_power;
    voltage_name : vpwr_int;
    direction : output;
    switch_function : "pd|pd_ana";
    pg_function : "vdda";   
  }
  pg_pin (vpwr_lv_int) {
    pg_type : internal_power;
    voltage_name : vpwr_lv_int;
    direction : output;
    switch_function : "pd_ana | pd";
    pg_function : "vccd";   
  }
  pg_pin (vpwrd_int) {
    pg_type : internal_power;
    voltage_name : vpwrd_int;
    direction : output;
    switch_function : "pd";
    pg_function : "vccd";   
  }
  pg_pin (vssa) {
    pg_type : primary_ground;
    voltage_name : vssa;
    direction : input;
  }
  pg_pin (vssa_q) {
    pg_type : primary_ground;
    voltage_name : vssa_q;
    direction : input;
  }
  pg_pin (vssd) {
    pg_type : primary_ground;
    voltage_name : vssd;
    direction : input;
  }
  pg_pin (vsub_agr) {
    pg_type : primary_ground;
    voltage_name : vsub_agr;
    direction : input;
  }
  pg_pin (vsub_vic) {
    pg_type : primary_ground;
    voltage_name : vsub_vic;
    direction : input;
  }
  area : 225344 ;
  dont_use : true ;
  dont_touch : true ;
  interface_timing : true;
  timing_model_type : "extracted";

  /* Power attributes. */
 /* cell_leakage_power : 1342697;*/
 leakage_power() {
      when : "!pd & !pd_ana & !scan_test_mode & enable_hv";
      value : 765079.48 ;
      related_pg_pin : vdda;
      }
 leakage_power() {
      when : "!pd & !pd_ana & !scan_test_mode & enable_hv";
      value : 577638.44 ;
      related_pg_pin : vccd;
      }
 leakage_power() {
      when : "!pd & pd_ana";
      value : 183525 ;
      related_pg_pin : vccd;
      }
 leakage_power() {
      when : "!pd & pd_ana";
      value : 0 ;
      related_pg_pin : vdda;
      }
  leakage_power() {
      when : "pd&!enable_hv & pd_ana" ;
      value : 35 ;
      related_pg_pin : vdda;
      }
  leakage_power() {
      when : "pd&!enable_hv & pd_ana" ;
      value : 19 ;
      related_pg_pin : vccd;
      }


