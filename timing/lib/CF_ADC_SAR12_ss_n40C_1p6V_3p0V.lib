cell( CF_ADC_SAR12 ) {
switch_cell_type : fine_grain;
is_macro_cell : true ;
  pg_pin (vboost) {
    pg_type : internal_power;
    voltage_name : vboost;
    direction : output;
  }
  pg_pin (VPUMP) {
    pg_type : primary_power;
    voltage_name : VPUMP;
    direction : input;
  } 
  pg_pin (vccd) {
    pg_type : primary_power;
    voltage_name : vccd;
    direction : input;
  }
  pg_pin (vccd_q) {
    pg_type : primary_power;
    voltage_name : vccd_q;
    direction : input;
  }
  pg_pin (vdda) {
    pg_type : primary_power;
    voltage_name : vdda;
    direction : input;
  }
  pg_pin (vdda_q) {
    pg_type : primary_power;
    voltage_name : vdda_q;
    direction : input;
  }
  pg_pin (vreflo) {
    pg_type : primary_ground;
    voltage_name : vreflo;
    direction : input;
  } 
  pg_pin (vpwr_int) {
    pg_type : internal_power;
    voltage_name : vpwr_int;
    direction : output;
    switch_function : "pd|pd_ana";
    pg_function : "vdda";   
  }
  pg_pin (vpwr_lv_int) {
    pg_type : internal_power;
    voltage_name : vpwr_lv_int;
    direction : output;
    switch_function : "pd_ana | pd";
    pg_function : "vccd";   
  }
  pg_pin (vpwrd_int) {
    pg_type : internal_power;
    voltage_name : vpwrd_int;
    direction : output;
    switch_function : "pd";
    pg_function : "vccd";   
  }
  pg_pin (vssa) {
    pg_type : primary_ground;
    voltage_name : vssa;
    direction : input;
  }
  pg_pin (vssa_q) {
    pg_type : primary_ground;
    voltage_name : vssa_q;
    direction : input;
  }
  pg_pin (vssd) {
    pg_type : primary_ground;
    voltage_name : vssd;
    direction : input;
  }
  pg_pin (vsub_agr) {
    pg_type : primary_ground;
    voltage_name : vsub_agr;
    direction : input;
  }
  pg_pin (vsub_vic) {
    pg_type : primary_ground;
    voltage_name : vsub_vic;
    direction : input;
  }
  area : 225344 ;
  dont_use : true ;
  dont_touch : true ;
  interface_timing : true;
  timing_model_type : "extracted";

  /* Power attributes. */
 /* cell_leakage_power : 718003;*/
 leakage_power() {
      when : "!pd & !pd_ana & !scan_test_mode & enable_hv";
      value : 317101.41 ;
      related_pg_pin : vdda;
      }
 leakage_power() {
      when : "!pd & !pd_ana & !scan_test_mode & enable_hv";
      value : 400785.62 ;
      related_pg_pin : vccd;
      }
 leakage_power() {
      when : "!pd & pd_ana";
      value : 180725 ;
      related_pg_pin : vccd;
      }
 leakage_power() {
      when : "!pd & pd_ana";
      value : 0 ;
      related_pg_pin : vdda;
      }
  leakage_power() {
      when : "pd&!enable_hv &pd_ana" ;
      value : 8 ;
      related_pg_pin : vdda;
      }
  leakage_power() {
      when : "pd&!enable_hv &pd_ana" ;
      value : 14 ;
      related_pg_pin : vccd;
      }


